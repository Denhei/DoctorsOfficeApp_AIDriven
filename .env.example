# Variáveis de ambiente lidas pelo ASP.NET Core (convenção Secao__Chave).
# Qualquer valor aqui sobrescreve o appsettings.json. Nenhum arquivo .env é carregado
# automaticamente: exporte as variáveis no shell ou no docker-compose.

ConnectionStrings__PostgresConnection="Host=localhost;Port=5432;Database=consultorio_db;Username=postgres;Password=postgrespassword"
ConnectionStrings__MongoConnection="mongodb://localhost:27017"
MongoDatabaseName="consultorio_mongo_db"

# Segurança JWT (mínimo 32 bytes; a API não sobe sem a chave)
Jwt__SecretKey="SUA_CHAVE_SUPER_SECRETA_E_LONGA_PARA_A_POC_ACADEMICA_2026_MINIMO_32_BYTES"
Jwt__Issuer="ConsultorioApi"
Jwt__Audience="ConsultorioApp"
Jwt__ExpirationHours=24

# Armazenamento de arquivos locais
Storage__UploadDirectory="./uploads"
